# ─── E2E Test Environment ────────────────────────────────────────────
# Copy to .env.e2e and fill in values for your staging environment.
# NEVER commit .env.e2e — it has real credentials.

# Base URL of the deployed environment under test.
# Examples:
#   https://staging.lionheartapp.com
#   https://lionheart-platform-git-staging.vercel.app
E2E_BASE_URL=https://staging.lionheartapp.com

# ─── Primary test organization (Org A) ──────────────────────────────
# An admin-role user must exist; tests assume this user has super-admin
# permissions so they can exercise the full surface.
E2E_ORG_A_SLUG=linfield
E2E_ORG_A_ID=00000000-0000-0000-0000-000000000000
E2E_ADMIN_EMAIL=e2e-admin@lionheart-test.com
E2E_ADMIN_PASSWORD=changeme-strong-password

# A "member"-role user for RBAC boundary testing. This account should
# NOT have users:invite, roles:manage, or events:approve.
E2E_MEMBER_EMAIL=e2e-member@lionheart-test.com
E2E_MEMBER_PASSWORD=changeme-strong-password

# ─── Secondary organization (Org B) — for tenancy isolation tests ──
E2E_ORG_B_SLUG=e2e-org-b
E2E_ORG_B_ID=00000000-0000-0000-0000-000000000001
E2E_ORG_B_ADMIN_EMAIL=e2e-admin@org-b-test.com
E2E_ORG_B_ADMIN_PASSWORD=changeme-strong-password

# ─── Runtime tuning ─────────────────────────────────────────────────
E2E_WORKERS=4

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/server.tsbuildinfo",
    "rootDir": ".",
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "src/app/api/**/*.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/hooks/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

{
  "name": "lionheart-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004 -H 127.0.0.1 --turbopack",
    "build": "prisma generate && NODE_OPTIONS='--max-old-space-size=8192' next build",
    "postinstall": "prisma generate && npm run hooks:install",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "typecheck:server": "NODE_OPTIONS='--max-old-space-size=6144' tsc --project tsconfig.server.json",
    "typecheck:client": "NODE_OPTIONS='--max-old-space-size=6144' tsc --project tsconfig.client.json",
    "typecheck:fast": "npm run typecheck:server & npm run typecheck:client & wait",
    "check:env": "node scripts/check-env.mjs",
    "auth:secret": "node scripts/generate-auth-secret.mjs",
    "build:deploy": "npm run check:env && npm run build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:architecture:staged": "node scripts/check-architecture.mjs --staged",
    "hooks:install": "node scripts/install-githooks.mjs",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -e .env -- prisma db push",
    "db:push:remote": "echo 'ERROR: db:push:remote is retired. Use db:migrate:remote instead.' && exit 1",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "db:migrate:remote": "dotenv -e .env -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -e .env -- prisma studio",
    "db:studio:remote": "dotenv -e .env -- prisma studio",
    "db:seed": "dotenv -e .env.local -e .env -- tsx prisma/seed.ts",
    "db:seed:remote": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:seed:athletics": "dotenv -e .env.local -e .env -- tsx prisma/seeds/seed-athletics.ts",
    "db:seed:conferences": "dotenv -e .env.local -e .env -- tsx prisma/seeds/seed-conferences.ts",
    "db:seed:it": "dotenv -e .env.local -e .env -- tsx prisma/seeds/seed-it.ts",
    "db:seed:maintenance": "dotenv -e .env.local -e .env -- tsx prisma/seeds/seed-maintenance.ts",
    "roles:sync-defaults": "dotenv -e .env.local -e .env -- tsx scripts/sync-default-role-permissions.ts",
    "smoke:campus": "node scripts/smoke-campus-auth-crud.mjs",
    "smoke:set-password": "node scripts/smoke-set-password.mjs",
    "smoke:inventory": "node scripts/smoke-inventory.mjs",
    "smoke:all": "node scripts/smoke-roles-teams.mjs && node scripts/smoke-settings-permissions.mjs && node scripts/smoke-campus-auth-crud.mjs && node scripts/smoke-set-password.mjs && node scripts/test-ui-permissions.mjs",
    "smoke:settings": "node scripts/smoke-settings-all.mjs",
    "smoke:conferences": "dotenv -e .env.local -e .env -- node scripts/smoke-conferences.mjs",
    "smoke:isolation": "dotenv -e .env.local -e .env -- node scripts/smoke-cache-isolation.mjs",
    "bench:cache": "dotenv -e .env.local -e .env -- node scripts/bench-cache.mjs",
    "audit:workflows": "node scripts/audit-worker-workflows.mjs",
    "audit:mobile-workflows": "AUDIT_WORKFLOW_MODE=mobile node scripts/audit-worker-workflows.mjs",
    "smoke:it": "npm run smoke:campus",
    "smoke:phase22": "node scripts/smoke-phase22.mjs",
    "stripe:setup": "dotenv -e .env.local -e .env -- node scripts/setup-stripe-products.mjs",
    "cleanup:churned": "dotenv -e .env.local -e .env -- node scripts/cleanup-churned-orgs.mjs",
    "perf:load": "node scripts/perf/run-perf.mjs load",
    "perf:stress": "node scripts/perf/run-perf.mjs stress",
    "perf:spike": "node scripts/perf/run-perf.mjs spike",
    "perf:soak": "node scripts/perf/run-perf.mjs soak",
    "perf:benchmark": "node scripts/perf/run-perf.mjs benchmark",
    "perf:benchmark:json": "node scripts/perf/run-perf.mjs benchmark --json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:auth": "playwright test --project=api e2e/api/auth-hardening.spec.ts",
    "test:e2e:injection": "playwright test --project=api e2e/api/input-injection.spec.ts",
    "test:e2e:perms": "playwright test --project=permissions",
    "test:e2e:matrix": "playwright test --project=permissions e2e/permissions/permission-matrix.spec.ts",
    "test:e2e:isolation": "playwright test --project=permissions e2e/permissions/tenant-isolation.spec.ts",
    "test:e2e:linkcheck": "playwright test --project=chromium e2e/ui/link-checker.spec.ts",
    "test:e2e:forms": "playwright test --project=chromium e2e/ui/forms-smoke.spec.ts",
    "test:e2e:flows": "playwright test --project=chromium e2e/ui/flows",
    "test:e2e:vr": "playwright test --project=chromium e2e/ui/visual-regression.spec.ts",
    "test:e2e:vr:update": "playwright test --project=chromium e2e/ui/visual-regression.spec.ts --update-snapshots",
    "test:e2e:monkey": "playwright test --project=chromium e2e/ui/monkey-test.spec.ts",
    "test:e2e:mobile": "playwright test --project=chromium e2e/ui/mobile.spec.ts",
    "inventory:routes": "node scripts/inventory-routes.mjs",
    "inventory:pages": "node scripts/inventory-pages.mjs",
    "inventory:all": "npm run inventory:routes && npm run inventory:pages",
    "test:e2e:a11y": "playwright test --project=a11y",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:crawl": "E2E_CRAWLER_SCREENSHOT=1 playwright test --project=chromium e2e/ui/link-crawler.spec.ts",
    "test:e2e:visual": "E2E_SCREENSHOTS=all playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:all": "npm run test && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@google/genai": "^1.40.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.43.0",
    "@serwist/next": "^9.5.6",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.90.21",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-mention": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "^3.23.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-signature-canvas": "^1.0.7",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "dompurify": "^3.4.2",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.34.3",
    "google-auth-library": "^10.6.1",
    "googleapis": "^168.0.0",
    "html5-qrcode": "^2.3.8",
    "ical-generator": "^10.2.0",
    "jose": "^6.1.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.564.0",
    "next": "^15.1.0",
    "nodemailer": "^7.0.7",
    "otplib": "^13.4.0",
    "papaparse": "^5.5.2",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-virtuoso": "^4.18.6",
    "recharts": "^3.7.0",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.6",
    "stripe": "^20.4.1",
    "ts-node": "^10.9.2",
    "twilio": "^5.13.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.6.4",
    "@types/mjml": "^4.7.4",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^7.0.11",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.12",
    "jsdom": "^29.0.1",
    "mjml": "^4.18.0",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}

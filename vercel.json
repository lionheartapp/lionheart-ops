{
  "framework": "nextjs",
  "regions": ["pdx1"],
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/maintenance-tasks",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "0 7,12,17 * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/erate-sync",
      "schedule": "0 6 * * *"
    }
  ]
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/client.tsbuildinfo",
    "rootDir": ".",
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/lib/**/*.ts",
    "src/hooks/**/*.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/app/api/**/*.ts"
  ]
}
